  Mostra i 4 punti di forza di Just in Time
{% endcomment %}

<div class="jit-trust-badges-wrapper page-width">
  <div class="jit-badges-grid">
    <div class="jit-badge-card">
      <div class="jit-badge-icon">🏬</div>
      <div class="jit-badge-content">
        <h3>Click & Collect Gratuito</h3>
        <p>Ordina online e ritira pronto in sede entro 2 ore a Muro Leccese.</p>
      </div>
    </div>
    <div class="jit-badge-card">
      <div class="jit-badge-icon">🚚</div>
      <div class="jit-badge-content">
        <h3>Spedizione 24/48h</h3>
        <p>Consegna rapida e tracciata con corriere espresso in Salento e in tutta Italia.</p>
      </div>
    </div>
    <div class="jit-badge-card">
      <div class="jit-badge-icon">🛠️</div>
      <div class="jit-badge-content">
        <h3>Laboratorio Assistenza</h3>
        <p>Tecnico dedicato in sede per riparazioni, upgrade SSD e travaso dati.</p>
      </div>
    </div>
    <div class="jit-badge-card">
      <div class="jit-badge-icon">💬</div>
      <div class="jit-badge-content">
        <h3>Supporto Diretto WhatsApp</h3>
        <p>Consulenza tecnica rapida e verifica disponibilità in tempo reale.</p>
      </div>
    </div>
  </div>
</div>

<style>
  .jit-trust-badges-wrapper {
    margin: 30px auto;
    padding: 0 20px;
  }
  .jit-badges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .jit-badge-card {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding: 20px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
  }
  .jit-badge-icon {
    font-size: 30px;
    line-height: 1;
  }
  .jit-badge-content h3 {
    margin: 0 0 6px 0;
    font-size: 16px;
    font-weight: 700;
    color: #0f4c81;
  }
  .jit-badge-content p {
    margin: 0;
    font-size: 13px;
    color: #64748b;
    line-height: 1.4;
  }
</style>
